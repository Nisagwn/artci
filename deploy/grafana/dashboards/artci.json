{
 "uid": "artci",
 "title": "Artçı — veri hattı",
 "tags": [
  "artci"
 ],
 "timezone": "Europe/Istanbul",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Kaynak sağlığı",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Kaynak erişilebilir mi",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "artci_source_up",
     "legendFormat": "{{source}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "KAPALI",
         "color": "red"
        },
        "1": {
         "text": "AÇIK",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "title": "Son başarılı erişimden beri",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - artci_source_last_success_timestamp_seconds",
     "legendFormat": "{{source}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 300
       },
       {
        "color": "red",
        "value": 900
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "title": "DLQ (son 1 saat)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source) (increase(artci_dlq_messages_total[1h]))",
     "legendFormat": "{{source}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "title": "Gelen rapor / dk",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source) (rate(artci_ingest_reports_total[5m])) * 60",
     "legendFormat": "{{source}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Kaynak gecikmesi (deprem → bize ulaşma)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, source) (rate(artci_ingest_lag_seconds_bucket[30m])))",
     "legendFormat": "p50 {{source}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, source) (rate(artci_ingest_lag_seconds_bucket[30m])))",
     "legendFormat": "p95 {{source}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "row",
   "title": "Tekilleştirme",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 8,
   "title": "Birleştirme kararları / dk",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (decision) (rate(artci_merge_decisions_total[5m])) * 60",
     "legendFormat": "{{decision}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "new_event: yeni olay · attached: mevcut olaya bağlandı · update: rapor revizyonu · noop: değişiklik yok"
  },
  {
   "id": 9,
   "title": "Bağlanma oranı (attached / yeni rapor)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(artci_merge_decisions_total{decision=\"attached\"}[1h])) / sum(rate(artci_merge_decisions_total{decision=~\"attached|new_event\"}[1h]))",
     "legendFormat": "oran"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "description": "Ani düşüş: kaynaklar arası fark büyümüş ya da eşikler sıkı; ani artış: farklı depremler birleşiyor olabilir."
  },
  {
   "id": 10,
   "type": "row",
   "title": "Bildirim ve özet",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
