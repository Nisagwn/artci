# deploy/.env olarak kopyalayın; bu dosya git'e girmez.
ARTCI_DOMAIN=artci.ornek.com
POSTGRES_PASSWORD=degistir-uzun-rastgele
GRAFANA_ADMIN_PASSWORD=degistir-uzun-rastgele

# Kaynaklara giden isteklerde iletişim bilgisi (Plan §5)
ARTCI_USER_AGENT=artci/0.1 (egitim projesi; iletisim: eposta@ornek.com)

# Telegram botu (@BotFather). Boşsa bildirimler yalnızca loglanır.
ARTCI_TELEGRAM_TOKEN=

# LLM özeti (OpenRouter vb.). Boşsa yalnızca şablonlu özet.
ARTCI_LLM_API_KEY=
# Boşsa anthropic/claude-haiku-5.5 (ücretli). Ücretsiz ve 15/15 doğrulanmış seçim;
# virgülle ayrılmış liste: ilki meşgulse OpenRouter ikinciyi dener.
ARTCI_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free
ARTCI_LLM_DAILY_USD=1
